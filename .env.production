# ─────────────────────────────────────────────────────────────────────────────
# FFBS Frontend — Production environment (S3 static hosting)
# Set VITE_API_BASE_URL to your Lightsail container service public endpoint.
# Example: https://container-service-1.abc123.us-east-1.cs.amazonlightsail.com
#
# How to use:
#   1. Replace the placeholder URL below with your actual Lightsail public URL
#   2. Run: npm run build
#   3. Upload the dist/ folder to S3
# ─────────────────────────────────────────────────────────────────────────────

# Lightsail container service public URL (no trailing slash)
VITE_API_BASE_URL=https://YOUR-LIGHTSAIL-URL-HERE

# Mapbox token — set your own, do not commit real tokens
VITE_MAPBOX_ID=YOUR-MAPBOX-TOKEN-HERE
