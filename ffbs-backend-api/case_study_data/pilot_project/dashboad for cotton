xt/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}}]},{"cell_type":"code","source":["# --- 3. Data Acquisition & Preprocessing ---\n","\n","# A. Sentinel-2 Processing (Optical)\n","def mask_s2_clouds(image):\n","    \"\"\"Masks clouds using the S2 Cloud Probability dataset.\"\"\"\n","    s2_cloudless = ee.ImageCollection('COPERNICUS/S2_CLOUD_PROBABILITY')\n","\n","    # Join S2 SR with Cloud Probability\n","    filtered_prob_collection = s2_cloudless.filter(ee.Filter.eq('system:index', image.get('system:index')))\n","\n","    # Define a default cloud probability image (e.g., all zeros, meaning no clouds)\n","    # This will be used if no matching cloud probability image is found.\n","    default_cloud_prob_image = ee.Image(0).rename('probability').toFloat()\n","\n","    # Use ee.Algorithms.If to select between the actual cloud_prob or the default\n","    cloud_prob_image = ee.Algorithms.If(\n","        filtered_prob_collection.size().eq(0), # Condition (server-side check)\n","        default_cloud_prob_image,             # True branch (use default)\n","        filtered_prob_collection.first()      # False branch (use the first image from the filtered collection)\n","    )\n","    cloud_prob = ee.Image(cloud_prob_image).select('probability')\n","\n","    is_not_cloud = cloud_prob.lt(40) # Threshold 40%\n","    return image.updateMask(is_not_cloud)\n","\n","# Load S2 Collection\n","s2_collection = (ee.ImageCollection('COPERNICUS/S2_SR_HARMONIZED')\n","    .filterBounds(roi)\n","    .filterDate(start_date, end_date)\n","    .filter(ee.Filter.lt('CLOUDY_PIXEL_PERCENTAGE', 50))\n","    .map(mask_s2_clouds))\n","\n","# B. Sentinel-1 Processing (SAR)\n","s1_collection = (ee.ImageCollection('COPERNICUS/S1_GRD')\n","    .filterBounds(roi)\n","    .filterDate(start_date, end_date)\n","    .filter(ee.Filter.listContains('transmitterReceiverPolarisation', 'VH'))\n","    .filter(ee.Filter.eq('instrumentMode', 'IW'))\n","    .filter(ee.Filter.eq('orbitProperties_pass', 'DESCENDING')) # Ensure consistent orbit\n","    .map(lambda img: img.addBands(img.select('VH').multiply(10.0).log10().rename('VH_dB'))) # Convert to dB\n","    .map(lambda img: img.addBands(img.select('VV').multiply(10.0).log10().rename('VV_dB'))))\n","\n","# --- 4. Create Indices & Stack Bands ---\n","\n","def add_ndvi(image):\n","    ndvi = image.normalizedDifference(['B8', 'B4']).rename('NDVI')\n","    return image.addBands(ndvi)\n","\n","# Map NDVI function\n","s2_collection = s2_collection.map(add_ndvi)\n","\n","# --- 5. Phenology Analysis (Addressing the Error) ---\n","# We calculate phenology here to ensure we understand the time series before classifying\n","\n","print(\"Calculating Phenology Metrics...\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":34},"id":"7a7_iXlS9AA9","executionInfo":{"status":"ok","timestamp":1771259685495,"user_tz":-300,"elapsed":55,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"a10c56a7-c695-49e3-bd7c-55873fefd5d4"},"execution_count":53,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Calculating Phenology Metrics...\n"]}]},{"cell_type":"code","source":["# Check if collection has data\n","s2_size = s2_collection.size().getInfo()\n","if s2_size == 0:\n","    print(\"WARNING: Sentinel-2 collection is empty. Adjust date/filter settings.\")\n","    phenology = ee.Image().rename('peak_ndvi', 'sos', 'eos').clip(roi)\n","else:\n","    # Smooth time series using a moving average (window of 15 days) or simple median\n","    # Here we use a simple approach: find the image with max NDVI\n","    max_ndvi_image = s2_collection.qualityMosaic('NDVI')\n","    peak_ndvi = max_ndvi_image.select('NDVI').rename('peak_ndvi')\n","\n","    # Start of Season (SOS) - Simplified approximation\n","    # We find the date where NDVI first crosses 0.3 (or similar threshold)\n","    # For robust SOS/EOS, we would normally use the where() logic on a time series\n","    sos = s2_collection.select('NDVI').min().rename('sos')\n","    eos = s2_collection.select('NDVI').min().rename('eos') # Placeholder logic\n","\n","    phenology = peak_ndvi.addBands(sos).addBands(eos)\n","\n","# --- 6. Feature Engineering (Creating the Composite for Classification) ---\n","\n","# We create seasonal composites (Start, Middle, End of season) to capture dynamics\n","def create_seasonal_composite(col, start, end, prefix):\n","    # Filter the specific window\n","    subset = col.filterDate(start, end)\n","    # Calculate median\n","    median = subset.median().clip(roi)\n","    # Rename bands with prefix (e.g., B2_s1)\n","    bands = median.bandNames().map(lambda b: ee.String(prefix).cat(ee.String(b)))\n","    return median.rename(bands)\n","\n","# Create time-step composites\n","# Early Season (Jun-Jul), Mid (Aug-Sep), Late (Oct-Dec)\n","composite_s1 = create_seasonal_composite(s1_collection, '2023-06-01', '2023-07-31', 's1_')\n","composite_s2 = create_seasonal_composite(s2_collection, '2023-06-01', '2023-07-31', 's2_')\n","composite_s2_mid = create_seasonal_composite(s2_collection, '2023-08-01', '2023-09-30', 's2_mid_')\n","\n","# Stack all composites + Phenology\n","stacked_image = composite_s1.addBands(composite_s2).addBands(composite_s2_mid).addBands(phenology)\n","\n","# Fill null values (masking holes) with 0 or mean for classification\n","stacked_image = stacked_image.unmask(0)\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"_lFtjaEw9sE9","executionInfo":{"status":"ok","timestamp":1771259686992,"user_tz":-300,"elapsed":1508,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"98441856-9686-42b7-b175-b79b9dc90ed6"},"execution_count":54,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}}]},{"cell_type":"code","source":["# --- 7. Training Samples Generation ---\n","# NOTE: In a real workflow, you would import your own FusionTable/Shapefile.\n","# Here, we simulate training points using NDVI thresholds (Pseudo-labeling).\n","\n","# Pseudo-Training logic:\n","# High NDVI and specific VH backscatter -> Likely Cotton\n","# Low NDVI -> Non-Crop\n","# Other High NDVI -> Other Crop\n","\n","# Create 1000 random points\n","random_points = ee.FeatureCollection.randomPoints(roi, 1000, 42)\n","\n","def extract_values(feature):\n","    vals = stacked_image.sampleRegions(collection=ee.FeatureCollection([feature]), scale=10, projection='EPSG:4326').first()\n","    return vals\n","\n","# This might be slow. In practice, use sampleRegions directly on the Image\n","print(\"Generating pseudo-training data...\")\n","training_data = stacked_image.sampleRegions(\n","    collection=random_points,\n","    scale=10\n",")\n","\n","# Filter out features with no data\n","training_data = training_data.filter(ee.Filter.notNull(['s2_NDVI']))\n","\n","# Add a 'class' property based on simple rules for demonstration\n","# Class 0: Non-Crop, 1: Cotton, 2: Other Crop\n","def assign_class(feature):\n","    # Access properties safely\n","    ndvi = ee.Number(feature.get('s2_NDVI'))\n","    vh = ee.Number(feature.get('s1_VH_dB'))\n","\n","    # Logic (Simplified)\n","    is_crop = ndvi.gt(0.4)\n","    is_cotton = is_crop.And(vh.lt(-18)) # Cotton often has distinct backscatter\n","\n","    # Use ee.Algorithms.If for conditional assignment with ee.Number\n","    label = ee.Algorithms.If(\n","        is_cotton,\n","        ee.Number(1), # If is_cotton is true, label is 1\n","        ee.Algorithms.If(\n","            is_crop,\n","            ee.Number(2), # Else if is_crop is true, label is 2\n","            ee.Number(0)  # Else, label is 0\n","        )\n","    )\n","\n","    return feature.set('landcover', label)\n","\n","training_data = training_data.map(assign_class)\n","\n","# --- 8. Classification: Step 1 (Cropland vs Non-Cropland) ---\n","# Filter training for binary classes (Crop:1, NonCrop:0)\n","binary_training = training_data.map(lambda f: f.set('binary_class', ee.Number(f.get('landcover')).gt(0)))\n","\n","# Check unique classes for binary_training before training\n","binary_class_values = binary_training.aggregate_histogram('binary_class').keys().getInfo()\n","\n","if len(binary_class_values) < 2:\n","    print(\"WARNING: Binary training data contains only one unique class for cropland classification. Setting cropland_mask to all non-crop (0).\")\n","    cropland_mask = ee.Image(0).rename('binary_class').clip(roi) # All non-crop\n","else:\n","    # Train RF Classifier\n","    classifier_cropland = ee.Classifier.smileRandomForest(50).train(\n","        features=binary_training,\n","        classProperty='binary_class',\n","        inputProperties=stacked_image.bandNames()\n","    )\n","    # Classify\n","    cropland_mask = stacked_image.classify(classifier_cropland).eq(1)\n","\n","# --- 9. Classification: Step 2 (Cotton vs Other Crops) ---\n","# We only care about pixels inside the cropland mask\n","cropland_pixels = training_data.filter(ee.Filter.gt('landcover', 0))\n","\n","# Check unique classes for cropland_pixels before training\n","cropland_pixels_class_values = cropland_pixels.aggregate_histogram('landcover').keys().getInfo()\n","\n","if len(cropland_pixels_class_values) < 2:\n","    print(\"WARNING: Cropland pixels training data contains less than two unique classes (cotton/other crop). Skipping specific cotton classification.\")\n","    # Default to 'Other Crop' (class 2) if only non-cotton is present or if distinction cannot be made.\n","    final_classification = ee.Image(2).rename('landcover').updateMask(cropland_mask) # Assume all are 'Other Crop' if cannot distinguish\n","else:\n","    # Train Cotton Classifier\n","    classifier_cotton = ee.Classifier.smileRandomForest(50).train(\n","        features=cropland_pixels,\n","        classProperty='landcover',\n","        inputProperties=stacked_image.bandNames()\n","    )\n","\n","    # Classify\n","    cotton_classification = stacked_image.classify(classifier_cotton)\n","\n","    # Apply Mask (Only keep cotton predictions inside the cropland mask)\n","    final_classification = cotton_classification.updateMask(cropland_mask)\n","\n","# --- 10. Post-Processing (Majority Filter) ---\n","# Using a convolution approach to smooth noise\n","# Ensure final_classification has a value (e.g., unmask to 0) before focal_mode\n","final_classification = final_classification.unmask(0).int() # Ensure it's integer type for focal_mode\n","kernel = ee.Kernel.square(radius=1, units='pixels')\n","final_smoothed = final_classification.focal_mode(kernel=kernel, iterations=1)\n","\n","# --- 11. Visualization ---\n","print(\"Displaying Map...\")\n","Map = geemap.Map()\n","Map.centerObject(roi, 12)\n","\n","# Visualize Sentinel-2 RGB\n","s2_vis = {'bands': ['B4', 'B3', 'B2'], 'min': 0, 'max': 3000}\n","Map.addLayer(s2_collection.median().clip(roi), s2_vis, 'Sentinel-2 RGB', True)\n","\n","# Visualize Phenology (Peak NDVI)\n","ndvi_vis = {'min': 0, 'max': 1, 'palette': ['white', 'green']}\n","Map.addLayer(phenology.select('peak_ndvi'), ndvi_vis, 'Peak NDVI', True)\n","\n","# Visualize Classification\n","class_vis = {'min': 0, 'max': 2, 'palette': ['black', 'white', 'cyan']} # 0=NonCrop, 1=Cotton, 2=Other\n","Map.addLayer(final_smoothed, class_vis, 'Final Cotton Map', True)\n","\n","Map"],"metadata":{"colab":{"base_uri":"http