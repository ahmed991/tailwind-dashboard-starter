training_data.filter(ee.Filter.gte('random', 0.7))\n","\n","if test_set.size().getInfo() > 0:\n","    # Train on train_set\n","    validator = ee.Classifier.smileRandomForest(50).train(\n","        features=train_set,\n","        classProperty='landcover',\n","        inputProperties=stacked_image.bandNames()\n","    )\n","\n","    # Validate\n","    confusion_matrix = test_set.classify(validator).errorMatrix('landcover', 'classification')\n","    print('Confusion Matrix:', confusion_matrix.getInfo())\n","    print('Overall Accuracy:', confusion_matrix.accuracy().getInfo())\n","else:\n","    print(\"Not enough samples for validation.\")\n","\n","# Export (Optional)\n","# task = ee.batch.Export.image.toDrive(\n","#     image=final_smoothed,\n","#     description='Cotton_Classification',\n","#     scale=10,\n","#     region=roi,\n","#     fileFormat='GeoTIFF'\n","# )\n","# task.start()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":52},"id":"UdCNkZ4M8rru","executionInfo":{"status":"ok","timestamp":1771260674794,"user_tz":-300,"elapsed":345098,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"62be472a-2e11-4871-dd0c-d5c685d0d507"},"execution_count":57,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Confusion Matrix: [[288, 0, 0], [0, 0, 0], [4, 0, 10]]\n","Overall Accuracy: 0.9867549668874173\n"]}]},{"cell_type":"code","source":["import matplotlib.pyplot as plt\n","import pandas as pd\n","import numpy as np\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"jx3JMEJMEz66","executionInfo":{"status":"ok","timestamp":1771260674810,"user_tz":-300,"elapsed":12,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"0b8e2a40-4935-4894-ccb8-1b0894efed9f"},"execution_count":58,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}}]},{"cell_type":"code","source":["# --- 1. Data Preparation ---\n","\n","# A. Calculate Area Statistics for Pie & Bar Charts\n","print(\"Calculating area statistics for charts...\")\n","\n","# We need the area for Cotton (1), Other Crops (2), and Non-Crop (0)\n","# We use the pixelArea image and group by the classification band\n","area_image = ee.Image.pixelArea().addBands(final_smoothed)\n","\n","# Reduce region to get the sum of areas for each class value\n","stats = area_image.reduceRegion(\n","    reducer=ee.Reducer.sum().group(\n","      groupField=1,\n","      groupName='classification'\n","    ),\n","    geometry=roi,\n","    scale=30,\n","    maxPixels=1e13\n",").getInfo()\n","\n","# Parse the GEE output into a Pandas DataFrame\n","# GEE returns a dictionary with a 'groups' list\n","groups = stats.get('groups')\n","df_area = pd.DataFrame(groups)\n","\n","# Map class integers to names\n","class_names = {0: 'Non-Crop', 1: 'Cotton', 2: 'Other Crops'}\n","df_area['class_name'] = df_area['classification'].map(class_names)\n","df_area['area_ha'] = df_area['sum'] / 10000 # Convert sq meters to Hectares\n","\n","# B. Calculate Time Series for Line Graph (Phenology)\n","print(\"Calculating phenology time series for Cotton...\")"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":52},"id":"q3mrYr0sE5mZ","executionInfo":{"status":"ok","timestamp":1771260857148,"user_tz":-300,"elapsed":182345,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"af9e0d6f-13a9-44e0-f676-11b33cfa60af"},"execution_count":59,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Calculating area statistics for charts...\n","Calculating phenology time series for Cotton...\n"]}]},{"cell_type":"code","source":["# Function to extract mean NDVI for Cotton areas over time\n","def get_time_series(col):\n","    def wrapper(img):\n","        # Mask the image to only include Cotton pixels (Class 1)\n","        cotton_mask = final_smoothed.eq(1)\n","        masked_ndvi = img.select('NDVI').updateMask(cotton_mask)\n","\n","        # Calculate mean NDVI within the ROI\n","        stat = masked_ndvi.reduceRegion(\n","            reducer=ee.Reducer.mean(),\n","            geometry=roi,\n","            scale=100, # Further increased scale to prevent timeout\n","            maxPixels=1e13 # Increased maxPixels limit\n","        )\n","        # Return a Feature with time and value\n","        return ee.Feature(None, {\n","            'system:time_start': img.get('system:time_start'),\n","            'mean_ndvi': stat.get('NDVI')\n","        })\n","    return col.map(wrapper)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"eJaoqdyGFn0o","executionInfo":{"status":"ok","timestamp":1771260857154,"user_tz":-300,"elapsed":69,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"df7cd0be-1936-4428-c1c7-efac8332acaa"},"execution_count":60,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}}]},{"cell_type":"code","source":["# Apply to the S2 Collection (with NDVI band already calculated)\n","# Note: If s2_collection is huge, this might take a moment\n","ts_features = get_time_series(s2_collection)\n","\n","# Convert to Pandas DataFrame\n","ts_list = ts_features.reduceColumns(ee.Reducer.toList(2), ['system:time_start', 'mean_ndvi']).getInfo()['list']\n","df_ts = pd.DataFrame(ts_list, columns=['timestamp', 'mean_ndvi'])\n","df_ts['date'] = pd.to_datetime(df_ts['timestamp'], unit='ms')\n","# Remove nulls (cloudy gaps)\n","df_ts = df_ts.dropna()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"LG7YflEcFsii","executionInfo":{"status":"ok","timestamp":1771261101669,"user_tz":-300,"elapsed":244531,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"a5048334-bcbc-4bbd-f105-a034f1bbb2a2"},"execution_count":61,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}}]},{"cell_type":"code","source":["# --- 2. Plotting ---\n","\n","# Set up the figure with subplots\n","fig, axes = plt.subplots(2, 2, figsize=(16, 12))\n","fig.suptitle('Cotton Classification & Phenology Analysis', fontsize=20)\n","\n","# Plot 1: Pie Chart (Area Distribution)\n","# ------------------------------------\n","colors = ['gray', 'cyan', 'lightgreen'] # Non-Crop, Cotton, Other Crops\n","\n","# Dynamically create explode list based on df_area content\n","explode_list = [0] * len(df_area['area_ha'])\n","if 'Cotton' in df_area['class_name'].values:\n","    cotton_index = df_area[df_area['class_name'] == 'Cotton'].index[0]\n","    explode_list[cotton_index] = 0.1\n","\n","axes[0, 0].pie(df_area['area_ha'],\n","               labels=df_area['class_name'],\n","               autopct='%1.1f%%',\n","               startangle=90,\n","               colors=[colors[i] for i in df_area['classification']], # Map colors based on original class index\n","               explode=explode_list)\n","axes[0, 0].set_title('Land Cover Distribution')\n","\n","\n","\n","\n","# Plot 2: Bar Chart (Absolute Area)\n","# ------------------------------------\n","bars = axes[0, 1].bar(df_area['class_name'], df_area['area_ha'], color=[colors[i] for i in df_area['classification']])\n","axes[0, 1].set_ylabel('Area (Hectares)')\n","axes[0, 1].set_xlabel('Class Type')\n","axes[0, 1].set_title('Estimated Area per Class')\n","# Add value labels on top of bars\n","for bar in bars:\n","    height = bar.get_height()\n","    axes[0, 1].annotate(f'{height:.1f} ha',\n","                        xy=(bar.get_x() + bar.get_width() / 2, height),\n","                        xytext=(0, 3), # 3 points vertical offset\n","                        textcoords=\"offset points\",\n","                        ha='center', va='bottom')\n","\n","# Plot 3: Line Graph (Phenology - Cotton NDVI Profile)\n","# ------------------------------------\n","axes[1, 0].plot(df_ts['date'], df_ts['mean_ndvi'], marker='o', linestyle='-', color='green', markersize=4)\n","axes[1, 0].set_xlabel('Date')\n","axes[1, 0].set_ylabel('Mean NDVI (Cotton Fields)')\n","axes[1, 0].set_title('Temporal NDVI Profile (Cotton Phenology)')\n","axes[1, 0].tick_params(axis='x', rotation=45)\n","axes[1, 0].grid(True, linestyle='--', alpha=0.7)\n","\n","# Add labels for phenology stages (Approximation based on shape)\n","# This is just visual annotation, you can adjust the text position manually\n","# Only add annotations if df_ts is not empty\n","if not df_ts.empty:\n","    axes[1, 0].annotate('Sowing', xy=(df_ts['date'].min(), 0.1), fontsize=9)\n","    # Check if there's enough data for peak and harvest annotations\n","    if len(df_ts) > 1:\n","        axes[1, 0].annotate('Peak', xy=(df_ts['date'].iloc[int(len(df_ts)/2)], 0.6), fontsize=9)\n","        axes[1, 0].annotate('Harvest', xy=(df_ts['date'].max(), 0.2), fontsize=9)\n","\n","# Plot 4: Bar Chart (Class Separability / Confidence)\n","# ------------------------------------\n","# We can visualize the Confidence of the classification\n","# If you have probability bands in your classification, use those.\n","# Alternatively, we show a simple \"Pixel Count\" vs \"Area\" sanity check\n","# Let's just show the Cotton Area summary in a different style or leave blank/put map\n","# For variety, let's show a Histogram of the Cotton NDVI values at Peak\n","if s2_collection.size().getInfo() > 0:\n","    peak_img = s2_collection.qualityMosaic('NDVI')\n","    cotton_mask = final_smoothed.eq(1)\n","\n","    # Sample values for histogram\n","    samples = peak_img.select('NDVI').updateMask(cotton_mask).sampleRegions(\n","      collection=ee.FeatureCollection.randomPoints(roi, 5000),\n","      scale=10\n","    )\n","\n","    # Extract to pandas\n","    sample_vals = samples.aggregate_array('NDVI').getInfo()\n","    df_hist = pd.DataFrame(sample_vals, columns=['NDVI'])\n","\n","    # Only plot histogram if df_hist is not empty\n","    if not df_hist.empty:\n","        axes[1, 1].hist(df_hist['NDVI'], bins=30, color='cyan', edgecolor='black')\n","        axes[1, 1].set_title('NDVI Distribution within Cotton Fields')\n","        axes[1, 1].set_xlabel('NDVI Value')\n","        axes[1, 1].set_ylabel('Frequency')\n","        axes[1, 1].axvline(df_hist['NDVI'].mean(), color='red', linestyle='dashed', linewidth=2, label='Mean')\n","        axes[1, 1].legend()\n","    else:\n","        axes[1, 1].text(0.5, 0.5, 'No Cotton Data Available for Histogram', ha='center')\n","else:\n","    axes[1, 1].text(0.5, 0.5, 'No Data Available', ha='center')\n","\n","plt.tight_layout(rect=[0, 0.03, 1, 0.95]) # Adjust for main title\n","plt.show()"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":1000},"id":"0rA5LcQSF0iA","executionInfo":{"status":"ok","timestamp":1771261492208,"user_tz":-300,"elapsed":390535,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"ea5b26d9-efd8-4cbb-99d0-5b72b61c0fbc"},"execution_count":62,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}},{"output_type":"display_data","data":{"text/plain":["<Figure size 1600x1200 with 4 Axes>"],"image/png":"\n"},"metadata":{}}]}]}