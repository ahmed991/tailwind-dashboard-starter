klearn.preprocessing import StandardScaler\n","import geemap\n","import warnings\n","warnings.filterwarnings('ignore')"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":17},"id":"_Hb8daa4H7M-","executionInfo":{"status":"ok","timestamp":1771256663435,"user_tz":-300,"elapsed":572,"user":{"displayName":"MUHAMMAD TAHIR","userId":"02140607321882752717"}},"outputId":"9a6cdb9d-32ce-450f-a8ff-f0b424890343"},"execution_count":6,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","            <style>\n","                .geemap-dark {\n","                    --jp-widgets-color: white;\n","                    --jp-widgets-label-color: white;\n","                    --jp-ui-font-color1: white;\n","                    --jp-layout-color2: #454545;\n","                    background-color: #383838;\n","                }\n","\n","                .geemap-dark .jupyter-button {\n","                    --jp-layout-color3: #383838;\n","                }\n","\n","                .geemap-colab {\n","                    background-color: var(--colab-primary-surface-color, white);\n","                }\n","\n","                .geemap-colab .jupyter-button {\n","                    --jp-layout-color3: var(--colab-primary-surface-color, white);\n","                }\n","            </style>\n","            "]},"metadata":{}}]},{"cell_type":"code","source":[],"metadata":{"id":"DzAycLUYH_Lo"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import ee\n","import pandas as pd\n","import numpy as np\n","import matplotlib.pyplot as plt\n","import seaborn as sns\n","from scipy import stats\n","from sklearn.preprocessing import StandardScaler\n","import geemap\n","import warnings\n","warnings.filterwarnings('ignore')\n","\n","\n","class CottonNDVICorrelationAnalysis:\n","    def __init__(self, start_year=2019, end_year=2023, roi=None):\n","        \"\"\"\n","        Initialize the correlation analysis class\n","        \"\"\"\n","        self.start_year = start_year\n","        self.end_year = end_year\n","        self.roi = roi if roi is not None else geemap.shp_to_ee('/content/Divisions_-_Khargone_in_IN - Polygon.shp')  # [min_lon, min_lat, max_lon, max_lat]\n","\n","    def get_cotton_ndvi(self, year, month_start=5, month_end=8):\n","        \"\"\"\n","        Extract cotton NDVI for May-August growing season\n","        \"\"\"\n","        start_date = f'{year}-{month_start:02d}-01'\n","        end_date = f'{year}-{month_end:02d}-30'\n","\n","        # Using MODIS NDVI (250m resolution)\n","        modis_ndvi_collection = ee.ImageCollection('MODIS/061/MOD13Q1') \\\n","            .filterDate(start_date, end_date) \\\n","            .filterBounds(self.roi) \\\n","            .select('NDVI')\n","\n","        # Calculate mean NDVI for the period, handling empty collection\n","        mean_ndvi = ee.Algorithms.If(\n","            modis_ndvi_collection.size().eq(0),\n","            ee.Image(0).rename('NDVI'),  # Return a zero image with the expected band name\n","            modis_ndvi_collection.mean()\n","        )\n","        # Cast to ee.Image as ee.Algorithms.If returns a ComputedObject.\n","        mean_ndvi = ee.Image(mean_ndvi).multiply(0.0001)  # Scale factor for MODIS NDVI\n","\n","        return mean_ndvi.clip(self.roi)\n","\n","    def get_meteorological_data(self, year, month_start=5, month_end=8):\n","        \"\"\"\n","        Extract meteorological data for May-August\n","        \"\"\"\n","        start_date = f'{year}-{month_start:02d}-01'\n","        end_date = f'{year}-{month_end:02d}-30'\n","\n","        # Temperature (using MODIS LST)\n","        temp_collection = ee.ImageCollection('MODIS/061/MOD11A2') \\\n","            .filterDate(start_date, end_date) \\\n","            .filterBounds(self.roi) \\\n","            .select('LST_Day_1km')\n","        temp = ee.Algorithms.If(\n","            temp_collection.size().eq(0),\n","            ee.Image(0).rename('LST_Day_1km'),\n","            temp_collection.mean()\n","        )\n","        temp = ee.Image(temp).multiply(0.02).subtract(273.15)  # Convert to Celsius\n","\n","        # Precipitation (using CHIRPS)\n","        precip_collection = ee.ImageCollection('UCSB-CHG/CHIRPS/PENTAD') \\\n","            .filterDate(start_date, end_date) \\\n","            .filterBounds(self.roi) \\\n","            .select('precipitation')\n","        precip = ee.Algorithms.If(\n","            precip_collection.size().eq(0),\n","            ee.Image(0).rename('precipitation'),\n","            precip_collection.sum()\n","        )\n","        precip = ee.Image(precip)\n","\n","        # Radiation (using ERA5-Land Surface Solar Radiation)\n","        radiation_collection = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY') \\\n","            .filterDate(start_date, end_date) \\\n","            .filterBounds(self.roi) \\\n","            .select('surface_solar_radiation_downwards')\n","        radiation = ee.Algorithms.If(\n","            radiation_collection.size().eq(0),\n","            ee.Image(0).rename('surface_solar_radiation_downwards'),\n","            radiation_collection.sum()\n","        )\n","        radiation = ee.Image(radiation)\n","\n","        # Wind speed (using ERA5)\n","        wind_u_collection = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY') \\\n","            .filterDate(start_date, end_date) \\\n","            .filterBounds(self.roi) \\\n","            .select('u_component_of_wind_10m')\n","        wind_u = ee.Algorithms.If(\n","            wind_u_collection.size().eq(0),\n","            ee.Image(0).rename('u_component_of_wind_10m'),\n","            wind_u_collection.mean()\n","        )\n","        wind_u = ee.Image(wind_u)\n","\n","        wind_v_collection = ee.ImageCollection('ECMWF/ERA5_LAND/MONTHLY') \\\n","            .filterDate(start_date, end_date) \\\n","            .filterBounds(self.roi) \\\n","            .select('v_component_of_wind_10m')\n","        wind_v = ee.Algorithms.If(\n","            wind_v_collection.size().eq(0),\n","            ee.Image(0).rename('v_component_of_wind_10m'),\n","            wind_v_collection.mean()\n","        )\n","        wind_v = ee.Image(wind_v)\n","\n","        # Calculate wind speed magnitude\n","        wind_speed = wind_u.hypot(wind_v).rename('wind_speed')\n","\n","\n","        return {\n","            'temperature': temp.clip(self.roi),\n","            'precipitation': precip.clip(self.roi),\n","            'radiation': radiation.clip(self.roi),\n","            'wind_speed': wind_speed.clip(self.roi)\n","        }\n","\n","    def extract_pixel_values(self, image, scale=1000):\n","        \"\"\"\n","        Extract pixel values as numpy array\n","        \"\"\"\n","        # Sample points within the ROI\n","        samples = image.sample(\n","            region=self.roi,\n","            scale=scale,\n","            numPixels=5000,  # Adjust based on your needs\n","            seed=42,\n","            geometries=False,\n","            projection='EPSG:4326' # Explicitly set projection\n","        )\n","\n","        # Convert to list and then to numpy array\n","        values = samples.aggregate_array('NDVI' if 'NDVI' in image.bandNames().getInfo() else 'constant')\n","        return np.array(values.getInfo())\n","\n","    def prepare_correlation_data(self):\n","        \"\"\"\n","        Prepare data for correlation analysis across all years\n","        \"\"\"\n","        all_data = []\n","\n","        for year in range(self.start_year, self.end_year + 1):\n","            print(f\"Processing year {year}...\")\n","\n","            # Get NDVI for cotton growing season\n","            ndvi_image = self.get_cotton_ndvi(year)\n","            # Get meteorological data\n","            met_data = self.get_meteorological_data(year)\n","\n","            # Extract pixel values for NDVI\n","            ndvi_values = self.extract_pixel_values(ndvi_image)\n","\n","            # Extract pixel values for meteorological variables and find min length\n","            extracted_met_values = {}\n","            min_current_len = len(ndvi_values) # Start with NDVI length as initial minimum\n","\n","            for var_name, var_image in met_data.items():\n","                var_values = self.extract_pixel_values(var_image.rename('constant'))\n","                extracted_met_values[var_name] = var_values\n","                min_current_len = min(min_current_len, len(var_values))\n","\n","            # Truncate all arrays to the smallest length found for this year\n","            ndvi_values = ndvi_values[:min_current_len]\n","            for var_name in extracted_met_values:\n","                extracted_met_values[var_name] = extracted_met_values[var_name][:min_current_len]\n","\n","            # Create dataframe for this year using truncated NDVI values\n","            year_data = pd.DataFrame({\n","                'year': year,\n","                'ndvi': ndvi_values\n","            })\n","\n","            # Add meteorological variables using their truncated values\n","            for var_name, var_values in extracted_met_values.items():\n","                year_data[var_name] = var_values\n","\n","            all_data.append(year_data)\n","\n","        # Combine all years\n","        final_data = pd.concat(all_data, ignore_index=True)\n","\n","        # Remove any NaN values\n","        final_data = final_data.dropna()\n","\n","        return final_data\n","\n","    def perform_correlation_analysis(self, data):\n","        \"\"\"\n","        Perform comprehensive correlation analysis\n","        \"\"\"\n","        # Variables for correlation\n","        variables = ['ndvi', 'temperature', 'precipitation', 'radiation', 'wind_speed']\n","\n","        # Pearson correlation\n","        pearson_corr = data[variables].corr(method='pearson')\n","\n","        # Spearman rank correlation (for non-linear relationships)\n","        spearman_corr = data[variables].corr(method='spearman')\n","\n","        # Partial correlations (controlling for other variables)\n","        from scipy import stats, linalg\n","\n","        def partial_corr(data, x, y, z):\n","            \"\"\"Calculate partial correlation between x and y controlling for z\"\"\"\n","            # Remove the effect of z\n","            data_array = data[[x, y] + z].values\n","            n = len(data_array)\n","\n","            # Correlation matrix\n","            corr_matrix = np.corrcoef(data_array.T)\n","\n","            # Calculate partial correlation\n","            try:\n","                precision_matrix = linalg.inv(corr_matrix)\n","                partial_corr = -precision_matrix[0, 1] / np.sqrt(precision_matrix[0, 0] * precision_matrix[1, 1])\n","            except:\n","                partial_corr = np.nan\n","\n","            return partial_corr\n","\n","        # Calculate partial correlations for NDVI with each meteorological factor\n","        partial_correlations = {}\n","        met_factors = ['temperature', 'precipitation', 'radiation', 'wind_speed']\n","\n","        for factor in met_factors:\n","            other_factors = [f for f in met_factors if f != factor]\n","            partial_correlations[f'ndvi_vs_{factor}'] = partial_corr(data, 'ndvi', factor, other_factors)\n","\n","        return {\n","            'pearson': pearson_corr,\n","            'spearman': spearman_corr,\n","            'partial': partial_correlations\n","        }\n","\n","    def visualize_correlations(self, data, correlation_results):\n","        \"\"\"\n","        Create comprehensive visualizations\n","        \"\"\"\n","        fig = plt.figure(figsize=(20, 15))\n","\n","        # 1. Correlation Matrix Heatmap\n","        ax1 = plt.subplot(2, 3, 1)\n","        sns.heatmap(correlation_results['pearson'],\n","                   annot=True,\n","                   cmap='coolwarm',\n","                   center=0,\n","                   square=True,\n","                   fmt='.2f',\n","                   cbar_kws={'label': 'Pearson Correlation'})\n","        ax1.set_title('Pearson Correlation Matrix\\n(May-August Growing Season)', fontsize=12, fontweight='bold')\n","\n","        # 2. Spearman Correlation Matrix\n","        ax2 = plt.subplot(2, 3, 2)\n","        sns.heatmap(correlation_results['spearman'],\n","                   annot=True,\n","                   cmap='coolwarm',\n","                   center=0,\n","                   square=True,\n","                   fmt='.2f',\n","                   cbar_kws={'label': 'Spearman Correlation'})\n","        ax2.set_title('Spearman Rank Correlation Matrix\\n(May-August Growing Season)', fontsize=12, fontweight='bold')\n","\n","        # 3. Partial Correlations Bar Plot\n","        ax3 = plt.subplot(2, 3, 3)\n","        factors = list(correlation_results['partial'].keys())\n","        values = list(correlation_results['partial'].values())\n","        colors = ['red' if v < 0 else 'green' for v in values]\n","\n","        bars = ax3.bar(range(len(factors)), values, color=colors, alpha=0.7)\n","        ax3.axhline(y=0, color='black', linestyle='-', linewidth=0.5)\n","        ax3.set_xticks(range(len(factors)))\n","        ax3.set_xticklabels([f.replace('ndvi_vs_', '') for f in factors], rotation=45, ha='right')\n","        ax3.set_ylabel('Partial Correlation Coefficient')\n","        ax3.set_title('Partial Correlations\\n(NDVI vs Meteorological Factors)', fontsize=12, fontweight='bold')\n","\n","        # Add value labels on bars\n","        for bar, value in zip(bars, values):\n","            height = bar.get_height()\n","            ax3.text(bar.get_x() + bar.get_width()/2., height,\n","                    f'{value:.3f}', ha='center', va='bottom' if height > 0 else 'top')\n","\n","        # 4. Scatter Plots with Regression Lines\n","        # Temperature vs NDVI\n","        ax4 = plt.subplot(2, 3, 4)\n","        ax4.scatter(data['temperature'], data['ndvi'], alpha=0.3, s=10)\n","        z = np.polyfit(data['temperature'], data['ndvi'], 1)\n","        p = np.poly1d(z)\n","        ax4.plot(np.sort(data['temperature']),\n","                p(np.sort(data['temperature'])),\n","                'r-', linewidth=2, label=f'Trend (r={correlation_results[\"pearson\"].loc[\"ndvi\", \"temperature\"]:.3f})')\n","        ax4.set_xlabel('Temperature (°C)')\n","        ax4.set_ylabel('NDVI')\n","        ax4.set_title('NDVI vs Temperature', fontsize=11, fontweight='bold')\n","        ax4.legend()\n","        ax4.grid(True, alpha=0.3)\n","\n","        # Precipitation vs NDVI\n","        ax5 = plt.subplot(2, 3, 5)\n","        ax5.scatter(data['precipitation'], data['ndvi'], alpha=0.3, s=10)\n","        z = np.polyfit(data['precipitation'], data['ndvi'], 1)\n","        p = np.poly1d(z)\n","        ax5.plot(np.sort(data['precipitation']),\n","                p(np.sort(data['precipitation'])),\n","                'b-', linewidth=2, label=f'Trend (r={correlation_results[\"pearson\"].loc[\"ndvi\", \"precipitation\"]:.3f})')\n","        ax5.set_xlabel('Precipitation (mm)')\n","        ax5.set_ylabel('NDVI')\n","        ax5.set_title('NDVI vs Precipitation', fontsize=11, fontweight='bold')\n","        ax5.legend()\n","        ax5.grid(True, alpha=0.3)\n","\n","        # Radiation vs NDVI\n","        ax6 = plt.subplot(2, 3, 6)\n","        ax6.scatter(data['radiation'], data['ndvi'], alpha=0.3, s=10)\n","        z = np.polyfit(data['radiation'], data['ndvi'], 1)\n","        p = np.poly1d(z)\n","        ax6.plot(np.sort(data['radiation']),\n","                p(np.sort(data['radiation'])),\n","                'g-', linewidth=2, label=f'Trend (r={correlation_results[\"pearson\"].loc[\"ndvi\", \"radiation\"]:.3f})')\n","        ax6.set_xlabel('Radiation (W/m²)')\n","        ax6.set_ylabel('NDVI')\n","        ax6.set_title('NDVI vs Radiation', fontsize=11, fontweight='bold')\n","        ax6.legend()\n","        ax6.grid(True, alpha=0.3)\n","\n","        plt.suptitle(f'Cotton NDVI Correlation with Meteorological Factors\\n(May-August {self.start_year}-{self.end_year})',\n","                    fontsize=16, fontweight='bold', y=1.02)\n","        plt.tight_layout()\n","        plt.savefig('cotton_ndvi_correlation_analysis.png', dpi=300, bbox_inches='tight')\n","        plt.show()\n","\n","    def temporal_analysis(self, data):\n","        \"\"\"\n","        Analyze temporal patterns and year-to-year variations\n","        \"\"\"\n","        # Group by year\n","        yearly_stats = data.groupby('year').agg({\n","            'ndvi': ['mean', 'std'],\n","            'temperature': 'mean',\n","            'precipitation': 'sum',\n","            'radiation': 'mean',\n","            'wind_speed': 'mean'\n","        }).round(3)\n","\n","        yearly_stats.columns = ['_'.join(col).strip() for col in yearly_stats.columns.values]\n","\n","        # Calculate year-to-year correlations\n","        yearly_correlations = {}\n","        for year in range(self.start_year + 1, self.end_year + 1):\n","            year_data = data[data['year'] == year]\n","            prev_year_data = data[data['year'] == year - 1]\n","\n","            if len(year_data) > 0 and len(prev_year_data) > 0:\n","                # Align data by taking mean values\n","                yearly_correlations[f'{year-1}_{year}'] = {\n","                    'ndvi_corr': np.corrcoef(prev_year_data['ndvi'].mean(), year_data['ndvi'].mean())[0, 1],\n","                    'temp_corr': np.corrcoef(prev_year_data['temperature'].mean(), year_data['temperature'].mean())[0, 1]\n","                }\n","\n","        return yearly_stats, yearly_correlations\n","\n","    def run_analysis(self):\n","        \"\"\"\n","        Run complete correlation analysis\n","        \"\"\"\n","        print(\"=\"*60)\n","        print(\"COTTON NDVI METEOROLOGICAL CORRELATION ANALYSIS\")\n","        print(f\"Period: May-August, {self.start_year}-{self.end_year}\")\n","        print(\"=\"*60)\n","\n","        # Prepare data\n","        print(\"\\n1. Preparing correlation data...\")\n","        data = self.prepare_correlation_data()\n","        print(f\"   Total samples: {len(data)}\")\n","\n","        # Perform correlation analysis\n","        print(\"\\n2. Performing correlation analysis...\")\n","        correlation_results = self.perform_correlation_analysis(data)\n","\n","        # Display results\n","        print(\"\\n3. Correlation Results:\")\n","        print(\"\\n   Pearson Correlation with NDVI:\")\n","        ndvi_corr = correlation_results['pearson']['ndvi'].drop('ndvi')\n","        for var, corr in ndvi_corr.items():\n","            print(f\"     {var}: {corr:.4f}\")\n","\n","        print(\"\\n   Spearman Correlation with NDVI:\")\n","        ndvi_spearman = correlation_results['spearman']['ndvi'].drop('ndvi')\n","        for var, corr in ndvi_spearman.items():\n","            print(f\"     {var}: {corr:.4f}\")\n","\n","        print(\"\\n   Partial Correlations (controlling for other factors):\")\n","        for factor, corr in correlation_results['partial'].items():\n","            print(f\"     {factor}: {corr:.4f}\")\n","\n","        # Temporal analysis\n","        print(\"\\n4. Temporal Analysis...\")\n","        yearly_stats, yearly_corrs = self.temporal_analysis(data)\n","        print(\"\\n   Yearly Statistics (May-August average):\")\n","        print(yearly_stats)\n","\n","        # Visualizations\n","        print(\"\\n5. Creating visualizations...\")\n","        self.visualize_correlations(data, correlation_results)\n","\n","        # Additional statistical tests\n","        print(\"\\n6. Statistical Significance Tests:\")\n","        for var in ['temperature', 'precipitation', 'radiation', 'wind_speed']:\n","            corr = correlation_results['pearson'].loc['ndvi', var]\n","            n = len(data)\n","            # Calculate p-value\n","            from scipy.stats import pearsonr\n","            _, p_value = pearsonr(data['ndv